<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Full regression: every test in the project.

  parallel="methods" with thread-count="3" is what the whole framework is built to support —
  each method gets its own thread, and therefore its own WebDriver, Playwright stack and page
  objects, all held in ThreadLocals. Raise thread-count on a bigger agent; nothing else changes.

  The API block runs first and single-threaded relative to the UI blocks below it because
  preserve-order applies per <test>: it is fast, and a failure there tells you the backend is
  broken before you spend minutes watching browsers fail for the same reason.
-->
<suite name="Regression Suite" verbose="1" parallel="methods" thread-count="3" configfailurepolicy="continue">

    <listeners>
        <listener class-name="com.qa.framework.listeners.TestListener"/>
        <listener class-name="com.qa.framework.listeners.RetryTransformer"/>
    </listeners>

    <test name="API - REST Assured">
        <classes>
            <class name="com.qa.tests.api.AuthApiTest"/>
            <class name="com.qa.tests.api.UserCrudApiTest"/>
            <class name="com.qa.tests.api.UserSearchApiTest"/>
        </classes>
    </test>

    <test name="UI - Selenium WebDriver">
        <classes>
            <class name="com.qa.tests.ui.selenium.LoginTest"/>
            <class name="com.qa.tests.ui.selenium.ProductListingTest"/>
            <class name="com.qa.tests.ui.selenium.CartTest"/>
            <class name="com.qa.tests.ui.selenium.CheckoutTest"/>
        </classes>
    </test>

    <test name="UI - Playwright">
        <classes>
            <class name="com.qa.tests.ui.playwright.PwLoginTest"/>
            <class name="com.qa.tests.ui.playwright.PwCartTest"/>
            <class name="com.qa.tests.ui.playwright.PwCheckoutTest"/>
        </classes>
    </test>
</suite>
