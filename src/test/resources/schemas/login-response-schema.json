{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Login response",
  "description": "Contract for POST /auth/login. The token patterns assert real JWT structure, not merely that a string came back.",
  "type": "object",
  "required": ["accessToken", "refreshToken", "id", "username", "email", "firstName", "lastName"],
  "properties": {
    "accessToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    },
    "refreshToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    },
    "id": { "type": "integer", "minimum": 1 },
    "username": { "type": "string", "minLength": 1 },
    "email": { "type": "string", "format": "email" },
    "firstName": { "type": "string", "minLength": 1 },
    "lastName": { "type": "string", "minLength": 1 },
    "gender": { "type": "string" },
    "image": { "type": "string" }
  }
}
